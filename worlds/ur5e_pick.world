<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ur5e_pick">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints><contact_max_correcting_vel>0.01</contact_max_correcting_vel>
          <contact_surface_layer>0.0001</contact_surface_layer></constraints>
      </ode>
    </physics>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <cast_shadows>true</cast_shadows>
    </light>
    <gui><camera name="user_camera"><pose>2 -2 1.9 0 0.35 2.35</pose></camera></gui>
    <model name="floor">
      <static>true</static><pose>0 0 -0.05 0 0 0</pose>
      <link name="floor_link">
        <collision name="collision"><geometry><box><size>10 10 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 10 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Tabletop at z=0.4 m; the UR base is mounted at the same height. -->
    <model name="work_table">
      <static>true</static><pose>0.35 0 0 0 0 0</pose>
      <link name="table">
        <collision name="top"><pose>0 0 0.38 0 0 0</pose>
          <geometry><box><size>1.2 1.0 0.04</size></box></geometry></collision>
        <visual name="top"><pose>0 0 0.38 0 0 0</pose>
          <geometry><box><size>1.2 1.0 0.04</size></box></geometry>
          <material><ambient>0.65 0.45 0.25 1</ambient><diffuse>0.65 0.45 0.25 1</diffuse></material></visual>
        <collision name="support"><pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>1.0 0.6 0.36</size></box></geometry></collision>
        <visual name="support"><pose>0 0 0.18 0 0 0</pose>
          <geometry><box><size>1.0 0.6 0.36</size></box></geometry>
          <material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Raise the target to the default open fingertips. Nominal initial joint
         positions are unchanged: [0, -1.57, 0, -1.57, 0, 0]. The grip plane
         is about 0.13 m from the Robotiq base, at world z=1.4794 m.
         This fixed support is separate from the freely movable target. -->
    <model name="practice_pedestal">
      <static>true</static><pose>0.0008 0.3829 0.4 0 0 0</pose>
      <link name="pedestal">
        <collision name="base"><pose>0 0 0.005 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.01</length></cylinder></geometry></collision>
        <visual name="base"><pose>0 0 0.005 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.3 0.35 0.4 1</diffuse></material></visual>
        <collision name="column"><pose>0 0 0.4947 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.9694</length></cylinder></geometry></collision>
        <visual name="column"><pose>0 0 0.4947 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.9694</length></cylinder></geometry>
          <material><ambient>0.45 0.5 0.55 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Free 40 mm diameter x 200 mm high cylinder, initially 1 mm above
         the pedestal. Optional robot-side exercise grasp assistance may hold it. -->
    <model name="practice_cylinder">
      <pose>0.0008 0.3829 1.4804 0 0 0</pose>
      <static>false</static>
      <link name="cylinder">
        <inertial><mass>0.05</mass><inertia>
          <ixx>0.000171666667</ixx><iyy>0.000171666667</iyy><izz>0.00001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <contact><ode><kp>2000</kp><kd>20</kd><max_vel>0.01</max_vel><min_depth>0.0001</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
          <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
